# dependencies
/node_modules
/.next/
/out/
.DS_Store
# large local video previews (keep posters tracked)
/public/videos/*
!/public/videos/posters/
!/public/videos/posters/**
!/public/videos/.gitkeep

# large videography binaries: videos live in the R2 bucket; poster images are tracked
/public/work/videography/*
!/public/work/videography/.gitkeep
!/public/work/videography/posters/
!/public/work/videography/posters/**
/public/videos/*
!/public/videos/posters/
!/public/videos/posters/**
!/public/videos/.gitkeep
